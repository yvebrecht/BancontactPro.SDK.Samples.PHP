# Copy to .env (git-ignored). One API key and PPID per product, as in Bancontact's onboarding email.
# Leave the products you do not have empty.
BANCONTACT_ONDISPLAY_API_KEY=
BANCONTACT_ONDISPLAY_PPID=
BANCONTACT_ONRECEIPT_API_KEY=
BANCONTACT_ONRECEIPT_PPID=
BANCONTACT_STATICQR_API_KEY=
BANCONTACT_STATICQR_PPID=
BANCONTACT_TOPUP_API_KEY=
BANCONTACT_TOPUP_PPID=

# Preprod (default) or Production. Do not point this sample at production with real money.
BANCONTACT_ENVIRONMENT=Preprod

# Public HTTPS address of this app (a tunnel), no trailing slash. Needed for Bancontact to reach the callback.
PUBLIC_BASE_URL=

PORT=5087

# Optional: another image tag, and the address the port is published on (default 127.0.0.1: the app has no login).
# SAMPLE_WEB_IMAGE=ghcr.io/yvebrecht/bancontactpro-sample-web-php:latest
# SAMPLE_WEB_BIND=127.0.0.1
